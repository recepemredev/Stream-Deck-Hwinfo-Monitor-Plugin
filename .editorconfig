root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,yml,yaml}]
indent_style = space
indent_size = 2

[package*.json]
indent_style = space
indent_size = 2

# `streamdeck pack` rewrites the manifest without a final newline; match it so packaging leaves no diff.
[*.sdPlugin/manifest.json]
insert_final_newline = false
